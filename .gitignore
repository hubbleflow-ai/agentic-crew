# Workspace volume · everything agents generate at runtime is ephemeral.
# Real dirs are workspace/task-<id>/ and workspace/evidence/<agent-id>/,
# which the old `workspace/tasks/` pattern never matched.
workspace/*
!workspace/.gitkeep

