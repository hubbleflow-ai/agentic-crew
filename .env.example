# Hubbleflow Crew · environment template
# Copy to .env and fill in your values. .env is gitignored.

# Gemini · Google AI Studio key · required (powers every agent via DeepAgents)
GOOGLE_API_KEY=AIza...
# Gemini model id (langchain-google-genai). Default: gemini-3.5-flash
GEMINI_MODEL=gemini-3.5-flash

# Optional · LangSmith for tracing
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=hubbleflow-crew

# Optional · Phoenix endpoint for observability
PHOENIX_COLLECTOR_ENDPOINT=http://phoenix:6006

# Logging
LOG_LEVEL=INFO

# Sandboxing · E2B. Get a key at e2b.dev (free $100 credit, no card).
E2B_API_KEY=
